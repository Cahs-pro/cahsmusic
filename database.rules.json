// Music Universe — Firebase Realtime Database qaydaları
// Firebase Console → Realtime Database → Rules bölməsinə köçürün
// (və ya firebase.json-ə "database": {"rules": "database.rules.json"} əlavə edib `firebase deploy --only database`).
// Mövcud qaydalarınız varsa, yalnız "rooms" blokunu əlavə etmək kifayətdir.
{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        "$fuid": {
          ".write": "auth != null && (auth.uid == $uid || auth.uid == $fuid)"
        }
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "$from": {
          ".write": "auth != null"
        }
      }
    },
    "dms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "stats": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null"
      }
    },

    // Ortaq playlistlər:
    // yaratmaq hər giriş etmiş istifadəçiyə açıqdır; dəyişiklik/silmə
    // yalnız sahib və üzvlər üçündür; üzvlük öz adına yazılır.
    "collab": {
      ".read": "auth != null",
      "$pid": {
        ".write": "auth != null && (!data.exists() || data.child('owner').val() == auth.uid || data.child('members').child(auth.uid).exists())",

        "songs": {
          "$vid": {
            ".write": "auth != null",
            ".validate": "newData.child('title').isString() && newData.child('title').val().length <= 200"
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        },

        "name":      { ".validate": "newData.isString() && newData.val().length <= 60" },
        "owner":     { ".validate": "newData.isString()" },
        "ownerName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "createdAt": { ".validate": "newData.isNumber()" }
      }
    },

    // Birlikdə dinləmə otaqları:
    // otağı hər giriş etmiş istifadəçi yarada bilər;
    // dəyişiklik (state/host) yalnız host və üzvlərə açıqdır;
    // üzvlük düyününü hər kəs yalnız özü üçün yaza bilər.
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (!data.exists() || data.child('host').val() == auth.uid || data.child('members').child(auth.uid).exists())",

        "state": {
          ".write": "auth != null && data.parent().child('members').child(auth.uid).exists()",
          ".validate": "newData.child('videoId').isString() && newData.child('videoId').val().length <= 20 && newData.child('playing').isBoolean() && newData.child('pos').isNumber() && newData.child('at').isNumber()"
        },

        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 80"
          }
        },

        "name":      { ".validate": "newData.isString() && newData.val().length <= 80" },
        "host":      { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" }
      }
    }
  }
}
